# Copy to .env (gitignored) to override local defaults used by docker-compose.yml
# and application.yaml. Defaults are fine for local development.
POSTGRES_PASSWORD=devpassword

# --- Authentication (single user). Required in production. ---
APP_USERNAME=dev
# Unset = a random password is generated and printed in the startup log.
APP_PASSWORD=dev
# At least 32 bytes; generate with: openssl rand -base64 48. Unset = random per start.
APP_JWT_SECRET=dev-only-secret-change-me-in-production-0123456789
APP_TOKEN_TTL_HOURS=72

# Browser origins allowed to call the API (comma-separated).
APP_CORS_ORIGINS=http://localhost:5173,https://intermediary-frontend.vercel.app

# --- Claude suggestions (optional). Leave unset to disable POST /ai/suggest. ---
ANTHROPIC_API_KEY=
APP_AI_MODEL=claude-opus-5

# Your local time zone (IANA name). Used for "today" on the server.
APP_TIMEZONE=America/New_York
